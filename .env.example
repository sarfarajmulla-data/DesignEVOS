# EVOS frontend environment template. Copy to .env.local and fill in when a backend exists.
# Only public, browser-safe values belong here. NEVER put a Supabase service-role key,
# database password or any other secret in a VITE_ variable — they are shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_EVOS_API_URL=
